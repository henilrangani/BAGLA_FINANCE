# Copy to backend/.env for local development. Never commit .env.
ENVIRONMENT=development
# Local PostgreSQL from docker-compose.yml (local-only credentials).
DATABASE_URL=postgresql+asyncpg://bagla:bagla_local_only@localhost:5432/bagla_finance
# REQUIRED: at least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# The React app's origin(s).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
