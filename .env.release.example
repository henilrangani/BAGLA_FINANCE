# BAGLA FINANCE release stack settings. Copy to .env.release and fill in.
# Never commit .env.release. scripts\windows\start.ps1 can generate these values for you.

# Required. Password for the NEW release database (not any older database on this machine).
POSTGRES_PASSWORD=
# Required. Random value of at least 32 characters used to sign sign-in tokens.
JWT_SECRET=

# Optional. Defaults shown.
POSTGRES_DB=bagla_beta_rc
POSTGRES_USER=bagla_rc
APP_PORT=8080

# Optional. Without a key, AI features use built-in rule-based answers. AI is advisory only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
