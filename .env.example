# Copy to .env for local development. Never commit .env or real secrets.

# Optional. Server-side only. Without it, AI routes use deterministic fallbacks
# (the ledger, budgets and reports never depend on AI).
GEMINI_API_KEY=

# Optional. Gemini model name. Model names change; check availability and
# pricing before deploying.
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional. Enables /api/webhooks/payment-sync. Use a long random value
# (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
# When empty the webhook endpoint is disabled (503).
WEBHOOK_SECRET=

# Optional. Extra origins allowed to call /api from a browser (comma separated).
# Same-origin requests are always allowed.
ALLOWED_ORIGINS=

# Local server binding. Keep 127.0.0.1 unless you need LAN access.
HOST=127.0.0.1
PORT=3000

# Set to 1 only when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=0
